/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    resisto-GEM base config: resources per label and error handling
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    process_low/medium/high match AMRBench_QC's conf/base.config at commit 52001eb,
    which its modules (QUAST, CheckM2, Bakta) were written for. Memory and time grow
    with each retry. Override per process with -c custom.config (see docs/usage.md).
----------------------------------------------------------------------------------
*/

process {
    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    maxRetries    = params.max_retries
    errorStrategy = { task.attempt <= params.max_retries ? 'retry' : 'terminate' }

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    // Per-genome steps: after the retries, a failing genome is skipped (unless --fail_fast) so that
    // one bad assembly does not stop a 12,000-genome run. Skipped genomes still appear in
    // resisto_gem_summary.tsv (status no_model / failed_after_carve) and in the execution trace.
    withName: 'QUAST|CHECKM2|BAKTA|CARVEME_CARVE|BUILD_STRAIN_MODEL|MODEL_QC' {
        errorStrategy = { task.attempt <= params.max_retries ? 'retry' : (params.fail_fast ? 'terminate' : 'ignore') }
    }
}
