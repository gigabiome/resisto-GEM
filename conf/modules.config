/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module options and publishing
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Large intermediate files are not published by default (sizes per genome, approximate):
    CarveMe drafts ~9 MB and DIAMOND tables ~0.6 MB (--publish_intermediates), full Bakta output
    tens of MB (--bakta_publish_all). Final models are gzip-compressed SBML (~0.4 MB).
----------------------------------------------------------------------------------
*/

process {
    // Environment of every model-building step (label 'resisto'), one of the three below, plus
    // optional cluster modules (--resisto_modules) for the solver licence:
    //   --resisto_env        existing environment folder (e.g. conda env with full CPLEX); its bin/
    //                        is put first on PATH and the task runs without a container. Works with
    //                        -profile apptainer, so the AMRBench_QC steps keep their containers.
    //   --resisto_container  Apptainer/Docker image with CPLEX (containers/resisto/build.sh)
    //   --resisto_conda      conda env path or file, used only with -profile conda
    withLabel: resisto {
        conda        = params.resisto_conda ?: "${projectDir}/envs/resisto.yml"
        container    = params.resisto_env ? null : params.resisto_container
        beforeScript = params.resisto_env ? "export PATH=\"${params.resisto_env}/bin:\$PATH\"" : ''
        // Cluster environment modules (e.g. Gurobi, which sets GRB_LICENSE_FILE for the licence)
        module       = params.resisto_modules ?: null
    }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
    ]

    // Same Bakta arguments as AMRBench_QC (conf/modules.config at commit 52001eb)
    withName: BAKTA {
        ext.args   = { "--keep-contig-headers ${params.bakta_args}" }
        publishDir = [
            path: { "${params.outdir}/bakta" },
            mode: params.publish_dir_mode,
            pattern: params.bakta_publish_all ? '*' : '*/*.{faa,gff3,tsv,txt}',
        ]
    }

    withName: CHECKM2 {
        publishDir = [
            path: { "${params.outdir}/checkm2" },
            mode: params.publish_dir_mode,
            pattern: '*/quality_report.tsv',
        ]
    }

    withName: CHECK_SOLVER {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode]
    }

    withName: PREPARE_REFERENCE {
        publishDir = [path: { "${params.outdir}/references" }, mode: params.publish_dir_mode]
    }

    withName: CARVEME_CARVE {
        publishDir = [
            path: { "${params.outdir}/carveme" },
            mode: params.publish_dir_mode,
            pattern: params.publish_intermediates ? '*' : '*.carve.json',
        ]
    }

    withName: BUILD_STRAIN_MODEL {
        publishDir = [path: { "${params.outdir}/models" }, mode: params.publish_dir_mode]
    }

    withName: MODEL_QC {
        publishDir = [path: { "${params.outdir}/qc" }, mode: params.publish_dir_mode]
    }

    withName: SUMMARISE {
        publishDir = [path: { "${params.outdir}" }, mode: params.publish_dir_mode]
    }

    withName: GUNZIP {
        publishDir = [enabled: false]
    }

    // Databases are downloaded once into db_dir and reused by later runs (as in AMRBench_QC)
    withName: 'BAKTA_DBDOWNLOAD|CHECKM2_DBDOWNLOAD' {
        storeDir   = { "${params.db_dir}" }
        publishDir = [enabled: false]
    }
}
