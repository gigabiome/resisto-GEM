/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    gigabiome/resisto-GEM Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defaults are the decisions recorded in docs/usage.md ("Defaults and why").
    Cluster-specific settings (executor, queues, scratch, container cache) belong in
    a separate config passed with -c.
----------------------------------------------------------------------------------
*/

params {
    // Input / output
    input                 = null                                      // samplesheet: sample,species,fasta
    outdir                = 'results'
    publish_dir_mode      = 'copy'
    publish_intermediates = false                                     // also publish CarveMe drafts + DIAMOND tables
    bakta_publish_all     = false                                     // publish every Bakta file, not only faa/gff3/tsv/txt

    // References and medium
    reference_registry    = "${projectDir}/assets/references.csv"     // species -> reference GEM, biomass, universe, sha256
    reference_dir         = "${projectDir}/reference_gems"            // filled by scripts/download_reference_gems.sh
    mediadb               = "${projectDir}/assets/media.tsv"          // CarveMe-format media library
    medium                = 'LB_btn'                                  // CarveMe LB + biotin

    // Reconstruction
    solver                = 'gurobi'                                  // gurobi | cplex | scip (docs/solver.md)
    diamond_args          = '--more-sensitive --top 10 --quiet'       // CarveMe 1.6.6 defaults (threads added per task)
    carve_reference_score = 0.0                                       // CarveMe --reference-score (CarveMe default 0.0)
    reference_bonus       = 1.0                                       // gap-fill score added to reference reactions
    min_growth            = 0.1                                       // gap-fill growth requirement (CarveMe default)
    gapfill_max_uptake    = 100                                       // medium uptake bound during gap-filling (CarveMe CLI)
    init_max_uptake       = 10                                        // medium uptake bound stored in the models (CarveMe -i)
    atpm_source           = 'reference'                               // R_ATPM bounds: reference | carveme
    qc_blocked            = true                                      // count blocked reactions in QC (FVA)

    // Environment for the model-building steps (CarveMe + MILP solver); see docs/solver.md
    resisto_modules       = null                                      // environment module(s) to load, e.g. 'gurobi/12.0.3'
    resisto_env           = null                                      // existing env folder (bin/ put on PATH), e.g. $HOME/envs/resisto-gem
    resisto_container     = null                                      // e.g. /path/to/resisto-gem.sif
    resisto_conda         = null                                      // existing conda env path; default envs/resisto.yml

    // AMRBench_QC steps (same meaning as in AMRBench_QC)
    bakta_db              = null
    bakta_db_type         = 'full'
    checkm2_db            = null
    db_dir                = "${launchDir}/databases"
    bakta_args            = ''

    // Error handling
    max_retries           = 2
    fail_fast             = false                                     // stop the run when a genome fails all retries
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    }
    conda {
        conda.enabled          = true
    }
    test {
        // The 140 test assemblies (paths relative to the repository root: launch from there)
        params.input           = "${projectDir}/data/test_sample_sheet.csv"
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}

manifest {
    name            = 'gigabiome/resisto-GEM'
    homePage        = 'https://github.com/gigabiome/resisto-GEM'
    description     = 'Strain-specific genome-scale metabolic models with CarveMe and species reference GEMs'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0dev'
    // AMRBench_QC modules live in the git submodule external/AMRBench_QC; fetch it when Nextflow
    // pulls the pipeline (nextflow run/pull gigabiome/resisto-GEM). A manual clone still needs
    // `git clone --recurse-submodules` or `git submodule update --init`.
    recurseSubmodules = true
}

includeConfig 'conf/modules.config'
